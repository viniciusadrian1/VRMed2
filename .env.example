# ---------------------------------------------------------------------------
# VRmed — variáveis de ambiente (MODELO)
# Copie este arquivo para `.env.local` e preencha os valores reais.
# `.env.local` e `.env` NUNCA devem ser versionados (já estão no .gitignore).
# Não coloque chaves ou senhas reais neste arquivo modelo.
# ---------------------------------------------------------------------------

# Chave da API da OpenAI — obrigatória para o chat tutor de IA.
# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Senha de acesso às páginas administrativas (/admin/feedback e /admin/insights).
# Use uma senha forte; é a única proteção dessas rotas na fase de IC.
ADMIN_PASSWORD=

# Analytics anônimas (Umami self-hosted recomendado, ou PostHog).
# URL base da instância de analytics e ID do site/projeto.
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# Spotify no rádio da Sala de Estudos (opcional). Client ID do app criado em
# https://developer.spotify.com/dashboard — é público (fluxo PKCE, sem segredo).
# Redirect URIs a cadastrar: http://127.0.0.1:3000/sala e https://<site>/sala.
# Sem esta variável o botão "Conectar Spotify" não aparece. Ver docs/SALA-SPOTIFY.md.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# URL pública do site (sem barra final), usada em canonical, Open Graph, sitemap e robots.
# No Render é opcional: sem ela o código usa RENDER_EXTERNAL_URL automaticamente.
# Defina se houver domínio próprio, ex.: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=

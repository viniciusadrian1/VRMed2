# ---------------------------------------------------------------------------
# VRmed — variáveis de ambiente (MODELO)
# Copie este arquivo para `.env.local` e preencha os valores reais.
# `.env.local` e `.env` NUNCA devem ser versionados (já estão no .gitignore).
# Não coloque chaves ou senhas reais neste arquivo modelo.
# ---------------------------------------------------------------------------

# Chave da API da OpenAI — obrigatória para o chat tutor de IA.
# Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Senha de acesso às páginas administrativas (/admin/feedback e /admin/insights).
# Use uma senha forte; é a única proteção dessas rotas na fase de IC.
ADMIN_PASSWORD=

# Analytics anônimas (Umami self-hosted recomendado, ou PostHog).
# URL base da instância de analytics e ID do site/projeto.
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_ID=
